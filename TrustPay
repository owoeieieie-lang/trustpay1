<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TrustPay USD Exchange</title>

<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">

<style>
/* ------------------ GENERAL ------------------ */
body{
  margin:0;
  font-family:'Roboto', sans-serif;
  background: linear-gradient(135deg, #0f172a, #1e293b);
  color:#fff;
  overflow-x:hidden;
}
a{text-decoration:none;}

/* ------------------ HEADER & BANNER ------------------ */
header{
  background:#020617;
  padding:20px;
  text-align:center;
  position:relative;
  overflow:hidden;
  border-bottom: 3px solid #22c55e;
}
header h1{
  color:#22c55e;
  font-size:28px;
  margin:10px 0 5px;
  animation: fadeInDown 1s ease;
}
header p{
  color:#94a3b8;
  margin:5px 0 15px;
  animation: fadeInUp 1s ease;
}
header .logo{
  position:absolute;
  top:-10px;
  left:20px;
  width:80px;
  height:80px;
  border-radius:15px;
  box-shadow:0 0 15px #22c55e;
  animation: floatLogo 3s ease-in-out infinite;
}
.banner{
  width:100%;
  max-width:600px;
  margin:15px auto 0;
  border-radius:18px;
  overflow:hidden;
  box-shadow:0 0 20px rgba(34,197,94,0.4);
  animation: fadeIn 1.5s ease;
}
.banner img{
  width:100%;
  height:auto;
  display:block;
  border-radius:18px;
}

/* ------------------ CONTAINER ------------------ */
.container{
  padding:20px;
  max-width:500px;
  margin:auto;
}

/* বাকি স্টাইল একই আছে... (নিচে পুরোটা দিলাম) */
.card{
  background: rgba(2,6,23,0.85);
  padding:15px;
  border-radius:15px;
  margin-bottom:15px;
  box-shadow:0 0 15px rgba(34,197,94,0.3);
  transition:0.3s;
}
.card:hover{transform:scale(1.02);}
button.buyBtn{
  width:100%;
  padding:10px;
  border:none;
  border-radius:8px;
  background:#22c55e;
  color:#000;
  font-weight:bold;
  cursor:pointer;
  transition:0.3s;
}
button.buyBtn:hover{background:#16a34a; transform:scale(1.05);}

.rate{text-align:center; font-size:18px; margin-bottom:20px; animation: fadeIn 1s ease;}
.whatsapp{
  position:fixed;
  bottom:20px;
  right:20px;
  background:#25D366;
  color:#000;
  padding:14px 18px;
  border-radius:50px;
  font-weight:bold;
  box-shadow:0 0 20px #25D366;
  animation: bounce 2s infinite;
}
footer{text-align:center; padding:15px; font-size:14px; color:#94a3b8; margin-top:20px;}

/* Animations */
@keyframes fadeIn{0%{opacity:0;}100%{opacity:1;}}
@keyframes fadeInDown{0%{opacity:0; transform:translateY(-20px);}100%{opacity:1; transform:translateY(0);}}
@keyframes fadeInUp{0%{opacity:0; transform:translateY(20px);}100%{opacity:1; transform:translateY(0);}}
@keyframes bounce{0%,100%{transform:translateY(0);}50%{transform:translateY(-10px);}}
@keyframes floatLogo {0%,100%{transform:translateY(0);}50%{transform:translateY(-10px);}}
.hidden{display:none;}
</style>
</head>

<body>

<header>
  <!-- Floating Logo (যদি চাও তাহলে রাখো, না হলে মুছে ফেলো) -->
  <img src="https://i.ibb.co/yourlogo.png" alt="TrustPay Logo" class="logo">
  
  <h1>TrustPay USD Exchange</h1>
  <p>Secure Dollar Buy Platform</p>
  
  <!-- এখানে তোমার নতুন ব্যানার -->
  <div class="banner">
    <img src="https://i.ibb.co/Your-New-Banner-Link-Here.png" alt="TrustPay Official Banner">
  </div>
</header>

<!-- বাকি অংশ একই আছে -->
<div class="container" id="loginBox">
  <div class="card">
    <h3>🔐 Login with Gmail</h3>
    <input type="email" id="email" placeholder="Enter your Gmail">
    <button onclick="login()">Login</button>
  </div>
</div>

<div class="container hidden" id="mainBox">
  <div class="rate">💱 <b>1 USD = 118 TK</b></div>
  <div id="list"></div>
</div>

<div class="container hidden" id="paymentBox">
  <div class="card">
    <h3>📲 Payment</h3>
    <p id="orderInfo"></p>
    <p>🔴 <b>bKash Personal</b></p>
    <b>01831825338</b><br><br>
    <p>🟠 <b>Nagad Personal</b></p>
    <b>01820345289</b>
    <input type="text" id="trxid" placeholder="Enter Transaction ID">
    <input type="text" id="balanceid" placeholder="Enter Your Balance ID">
    <button onclick="confirmOrder()">Confirm Order</button>
  </div>
</div>

<a class="whatsapp" href="https://wa.me/8801831825338" target="_blank">
💬 WhatsApp Support
</a>

<footer>
© 2026 TrustPay USD Exchange | Trusted Service
</footer>

<script>
const rate = 118;
const dollars = [1,2,3,5,10,20,100];
let selected = 0;

function login(){
  const email = document.getElementById("email").value;
  if(email === ""){alert("Enter Gmail!"); return;}
  document.getElementById("loginBox").classList.add("hidden");
  document.getElementById("mainBox").classList.remove("hidden");
}

const list = document.getElementById("list");
dollars.forEach(d=>{
  const tk = d*rate;
  list.innerHTML += `
    <div class="card">
      <b>${d} USD</b> = ${tk} TK
      <br><br>
      <button class="buyBtn" onclick="buy(${d})">Buy Now</button>
    </div>
  `;
});

function buy(amount){
  selected = amount;
  document.getElementById("paymentBox").classList.remove("hidden");
  document.getElementById("orderInfo").innerHTML =
    "🪙 Selected: <b>"+amount+" USD</b><br>💰 Pay: <b>"+(amount*rate)+" TK</b>";
}

function confirmOrder(){
  const trx = document.getElementById("trxid").value;
  const bal = document.getElementById("balanceid").value;
  if(trx === "" || bal === ""){alert("Transaction ID & Balance ID required!"); return;}
  alert("✅ Order Submitted!\nOur team will confirm shortly.");
}
</script>

</body>
</html>
